# Choose groq, gemini or ollama. Only the selected provider needs credentials.
ACTIVE_LLM=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT=120
# GEMINI_API_KEY=
# GROQ_API_KEY=
# Optional curated corpus for local search; disabled unless explicitly configured.
# RAG_ROOT=/absolute/path/to/curated/docs
# Optional GitHub export CLI scope (process environment; CLI does not load .env).
# GITHUB_EXPORT_REPO=owner/repository
# Supply GITHUB_EXPORT_TOKEN securely in the process environment for --apply.
